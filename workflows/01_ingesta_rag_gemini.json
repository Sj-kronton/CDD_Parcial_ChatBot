{
  "name": "UNAB - Ingesta RAG (Gemini)",
  "nodes": [
    {
      "parameters": {
        "content": "## Ingesta RAG UNAB (Gemini)\n\n1. Abre 'Get files from folder' y elige TU carpeta de Drive.\n2. Asigna credenciales: Google Drive, Postgres (Supabase) y Google Gemini (API key).\n3. En 'Embeddings Google Gemini' verifica el modelo en el desplegable.\n4. 'Preparar Tabla Vectorial' crea la tabla y la VACIA en cada ejecucion (recarga completa).\n5. Tras la primera carga: revisa la dimension con vector_dims() y crea el indice si aplica.",
        "height": 300,
        "width": 480,
        "color": 5
      },
      "id": "0e1cacfa-02d3-46c5-96e8-0d5b104a9d4f",
      "name": "Notas de Configuración",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "id": "7d0f6075-2312-4605-8cab-8abef0277745",
      "name": "Ejecutar Manualmente",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        416
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 6
            }
          ]
        }
      },
      "id": "34eb2251-7390-4f96-8977-c6130f18f89e",
      "name": "Programado (Semanal Lunes 6am)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        608
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE EXTENSION IF NOT EXISTS vector SCHEMA public;\nCREATE EXTENSION IF NOT EXISTS pgcrypto;\n\nCREATE TABLE IF NOT EXISTS unab.documentos_vectoriales (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n  content text,\n  metadata jsonb,\n  embedding public.vector\n);\n\nCREATE INDEX IF NOT EXISTS idx_docvec_metadata\n  ON unab.documentos_vectoriales USING gin (metadata);\n\n-- Recarga completa: evita duplicados al re-ejecutar el flujo\nTRUNCATE TABLE unab.documentos_vectoriales;",
        "options": {}
      },
      "id": "4a6f8b6a-337e-4b3a-9378-0840ae861c92",
      "name": "Preparar Tabla Vectorial",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        224,
        480
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "filter": {
          "folderId": {
            "__rl": true,
            "value": "",
            "mode": "list"
          }
        },
        "options": {}
      },
      "id": "7f560e83-b458-4b0c-ada3-ff5fab355e86",
      "name": "Get files from folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        432,
        480
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-mimetype-soportado",
              "leftValue": "={{ $json.name }}",
              "rightValue": ".*\\.md$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "358bf129-3ec9-425c-9a6b-152d8f75b638",
      "name": "Filtrar Solo Markdown (.md)",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        656,
        480
      ]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        },
        "options": {
          "binaryPropertyName": "data"
        }
      },
      "id": "d6939c08-d14c-4686-9948-215cc5b75677",
      "name": "Descargar Archivo Markdown",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        880,
        480
      ]
    },
    {
      "parameters": {
        "mode": "insert",
        "tableName": "unab.documentos_vectoriales",
        "options": {
